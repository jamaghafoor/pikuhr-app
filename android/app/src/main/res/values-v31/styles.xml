<resources>
    <!-- Render our full native artwork directly instead of the system's masked icon preview. -->
    <style name="LaunchTheme" parent="AppTheme">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#4D87D7</item>
        <item name="android:navigationBarColor">#4DD7D6</item>
    </style>
</resources>
